PORT=3000
BROWSER=none
REACT_APP_API_URL=http://localhost:8000
REACT_APP_API_BASE_URL=http://localhost:8000/api
# Protecao adicional: os meios Asaas deste fluxo existem apenas no frontend dev.
REACT_APP_ASAAS_SALES_MODE=sandbox
# Somente o cliente Asaas usa este caminho; o proxy CRA o envia ao servico
# isolado em loopback sem alterar as demais APIs do portal.
REACT_APP_ASAAS_SALES_API_URL=/api
