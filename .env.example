# Application
ENVIRONMENT=development
JWT_SECRET=change-me
JWT_LEGACY_SECRET=
PASSWORD_RESET_PEPPER=change-me-with-at-least-32-random-bytes

# Database
DB_HOST=localhost
DB_NAME=grupojfdb
DB_USER=grupojf_user
DB_PASSWORD=change-me
DB_PORT=5432

# Runtime global: API principal e integracoes existentes
# Este arquivo usa apenas placeholders publicos. Configure integracoes por
# variaveis de ambiente, sem copiar dados de ambiente operacional.
PATIENT_INTEGRATION_ENABLED_UNITS=

# Asaas da integracao global/de pacientes
# Nao altere este ambiente para testar vendas sem configurar as variaveis
# especificas da aplicacao.
ASAAS_ENVIRONMENT=sandbox
ASAAS_USER_AGENT=GrupoJF/1.0
ASAAS_API_KEY=change-me
ASAAS_SANDBOX_API_KEY=change-me
ASAAS_PRODUCTION_API_KEY=change-me
# Conta-mae por unidade (obrigatoria nas integracoes estritas por unidade)
ASAAS_PRODUCTION_API_KEY_NOVA_IGUACU_1=change-me
ASAAS_WALLET_ID_NOVA_IGUACU_1=change-me
ASAAS_PRODUCTION_API_KEY_SAO_JOAO_DE_MERITI=change-me
ASAAS_WALLET_ID_SAO_JOAO_DE_MERITI=change-me
ASAAS_PRODUCTION_API_KEY_VILAR=change-me
ASAAS_WALLET_ID_VILAR=change-me
ASAAS_PRODUCTION_API_KEY_BELFORD_ROXO=change-me
ASAAS_WALLET_ID_BELFORD_ROXO=change-me
# Sandbox estrito usa chave e wallet proprios do mesmo ambiente/unidade
ASAAS_SANDBOX_API_KEY_NOVA_IGUACU_1=change-me
ASAAS_SANDBOX_WALLET_ID_NOVA_IGUACU_1=change-me
ASAAS_SANDBOX_API_KEY_SAO_JOAO_DE_MERITI=change-me
ASAAS_SANDBOX_WALLET_ID_SAO_JOAO_DE_MERITI=change-me
ASAAS_SANDBOX_API_KEY_VILAR=change-me
ASAAS_SANDBOX_WALLET_ID_VILAR=change-me
ASAAS_SANDBOX_API_KEY_BELFORD_ROXO=change-me
ASAAS_SANDBOX_WALLET_ID_BELFORD_ROXO=change-me

# Splits Asaas (PF/empresas).
# Wallets de empresas PJ (sem sufixo de unidade).
ASAAS_SANDBOX_WALLET_ID_PARTMED=
ASAAS_SANDBOX_WALLET_ID_AKIMAIS=
# Chave Fernet para cifrar apiKey de subcontas (users.asaas_account_api_key_enc).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ASAAS_ACCOUNT_API_KEY_SECRET=
CLUBE_CERTO_TOKEN=change-me

# Delta/Bempaggo/Boleto/Carne tokens
API_TOKEN_AKIMAIS=change-me
API_TOKEN_BEMPAGGO_SANDBOX_users=change-me
API_TOKEN_BEMPAGGO_SANDBOX_patients=change-me
API_TOKEN_BEMPAGGO_NI1_patients=change-me
API_TOKEN_BEMPAGGO_SJM_patients=change-me
API_TOKEN_BEMPAGGO_VILAR_patients=change-me
API_TOKEN_BEMPAGGO_BFR_patients=change-me
API_TOKEN_BOLETO_SANDBOX=change-me
API_TOKEN_CARNE_SANDBOX=change-me
API_TOKEN_DELTA_AVULSA_SANDBOX=change-me
API_TOKEN_DELTA_RECORRENTE_SANDBOX=change-me

# Product/seller IDs
DELTA_AVULSA_PRODUCT_ID=change-me
DELTA_RECORRENTE_PRODUCT_ID=change-me
SELLER_ID_AKIMAIS_NI1=change-me
SELLER_ID_PARTMED_NI1=change-me

# W-API WhatsApp instances
WAPI_BASE_URL=https://api.w-api.app/v1
WAPI_NI1_INSTANCE_ID=change-me
WAPI_NI1_TOKEN=change-me
WAPI_SJM_INSTANCE_ID=change-me
WAPI_SJM_TOKEN=change-me
WAPI_BFR_INSTANCE_ID=change-me
WAPI_BFR_TOKEN=change-me
WAPI_VILAR_INSTANCE_ID=change-me
WAPI_VILAR_TOKEN=change-me

# WhatsApp Cloud API oficial da Meta
META_WHATSAPP_GRAPH_API_VERSION=v23.0
META_WHATSAPP_APP_ID=change-me
META_WHATSAPP_ACCESS_TOKEN=change-me
META_WHATSAPP_NI_WABA_ID=change-me
META_WHATSAPP_NI_PHONE_NUMBER_ID=change-me
META_WHATSAPP_SJM_WABA_ID=change-me
META_WHATSAPP_SJM_PHONE_NUMBER_ID=change-me
META_WHATSAPP_VILAR_WABA_ID=change-me
META_WHATSAPP_VILAR_PHONE_NUMBER_ID=change-me

# Caixa Firebird: caminho absoluto para JSON privado, fora do repositorio.
# O JSON contem as seis fontes e nunca deve ser versionado.
CAIXA_FIREBIRD_CONFIG_PATH=/caminho/privado/caixa-firebird.json
CAIXA_FIREBIRD_TIMEOUT_SECONDS=15
